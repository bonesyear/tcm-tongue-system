# Python
__pycache__/
.pytest_cache/
.venv/
*.pyc
*.pyo
*.egg-info/
dist/

# System
.DS_Store
.env
.privacy-words
.backup_manifest

# 本地工具配置(Claude Code 会话本地设置,不入库)
.claude/

# Generated data
records/daily/*
records/weekly/*
charts/*

# Keep directory structures
!records/daily/.gitkeep
!records/weekly/.gitkeep
!charts/.gitkeep

# 版权物：《经方探源》全文仅限本地个人研究使用，不入版本库
# （见 knowledge_base/README.md 版权说明）
knowledge_base/jingfang_tanyuan_full.md

# 档案备份目录（含真实病案/姓名，禁止入公开仓库）
records/_backup/

# Web 层上传的原始照片（健康数据，永不上传）
records/photos/

# 一日任务书（跨 Agent 派工单）：仅本地使用，不入库（AGENTS.md §2 约定）
docs/*_TASK_*.md

# 版权电子书原文（版权物，仅限本地对照研究，不入版本库）
*.epub

# 版权 PDF 电子书（同 epub 约定）
*.pdf
# 原书电子版（版权所有，永不提交、不进检索语料；仅本机锚点复核用）
_books/

# Web 服务运行日志（本地）
records/_*.log

# 私有知识库：公开仓仅保留配置说明，内容不得再提交
knowledge_base/*
!knowledge_base/README.md

# 仓库内独立私有资料目录（与程序管理的 private_kb/ 隔离）
private/

# 导入的私有知识库与暂存区（仅本机，永不入库）
private_kb/
.kb-staging/
.kb-backup-*/
.kb-failed-*/
.kb-preserve-*/
.kb-reset-backup-*/
