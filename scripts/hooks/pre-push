#!/usr/bin/env bash
# 公开仓库 pre-push 隐私与版本守卫：只拦截，不打印敏感内容。
set -uo pipefail

REPO="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
COMMON_GIT_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
case "$COMMON_GIT_DIR" in
  */worktrees/*) COMMON_GIT_DIR="${COMMON_GIT_DIR%%/worktrees/*}" ;;
esac
WORDS_FILE="${PRIVACY_WORDS_FILE:-$COMMON_GIT_DIR/../.privacy-words}"
SCANNER="$REPO/scripts/hooks/privacy_scan.py"
FAIL=0
CHECKED=0

if [ ! -f "$WORDS_FILE" ]; then
  echo "❌ 未找到敏感词表 $WORDS_FILE；拒绝放行。可显式创建空词表或设置 PRIVACY_WORDS_FILE" >&2
  exit 1
fi
if [ ! -f "$SCANNER" ]; then
  echo "❌ 未找到隐私扫描器 $SCANNER，拒绝放行" >&2
  exit 1
fi
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "❌ 未找到 Python，无法执行隐私扫描，拒绝放行" >&2
  exit 1
fi

check_version_consistency() {
  local commit="$1"
  local ver cl
  ver="$(git show "$commit:VERSION" 2>/dev/null | tr -d '[:space:]')"
  cl="$(git show "$commit:CHANGELOG.md" 2>/dev/null | grep -m1 -oE '^## v[0-9]+\.[0-9]+\.[0-9]+' | sed 's/^## v//')"
  if git show "$commit:CHANGELOG.md" 2>/dev/null | grep -qE '^##[[:space:]]+Unreleased'; then
    echo "  ❌ CHANGELOG 仍有未归类的 Unreleased 版本段"
    FAIL=1
  fi
  if [ -z "$ver" ] || [ -z "$cl" ]; then
    echo "  (VERSION 或 CHANGELOG 缺失 / 无版本条目 —— 跳过版本一致性检查)"
    return
  fi
  if [ "$ver" != "$cl" ]; then
    echo "  ❌ 版本不一致：VERSION=$ver，CHANGELOG 最新条目=v$cl"
    echo "     修复：把 VERSION 改成 $cl（不带 v），或修改 CHANGELOG 使二者一致。"
    FAIL=1
  else
    echo "  ✓ 版本一致：v$ver"
  fi
}

echo "════════ Hermes 隐私守卫（pre-push）════════"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if ! commits="$(git rev-list "$local_sha" --not --remotes="$1" 2>/dev/null)"; then
    echo "❌ 无法计算 $local_ref 的新提交范围，拒绝放行" >&2
    exit 1
  fi
  [ -z "$commits" ] && continue
  echo "▶ 检查 $local_ref → $remote_ref"
  CHECKED=$((CHECKED+1))
  check_version_consistency "$local_sha" </dev/null

  args=("$SCANNER" --repo "$REPO" --words "$WORDS_FILE" --commits "$commits")
  if [[ "$local_ref" == refs/tags/* ]] \
      && [ "$(git cat-file -t "$local_sha")" = "tag" ]; then
    args+=(--tag "$local_sha")
  fi
  "$PYTHON" "${args[@]}" </dev/null || FAIL=1
done
echo "═══════════════════════════════════════════"

if [ "$CHECKED" -eq 0 ]; then
  echo "（没有需要检查的新提交）"
  exit 0
fi
if [ "$FAIL" -eq 1 ]; then
  cat <<'EOF'
🚫 守卫检查未通过 —— push 已阻止（隐私 / 凭证 / 版本一致性）。
含敏感内容的提交必须从历史中 amend / rebase 清除；新增删除提交不能清除历史。
确认是误报时可人工复核后用 git push --no-verify，并记录豁免理由。
EOF
  exit 1
fi

echo "✅ 守卫通过 —— 提交范围、内容、消息与版本检查完成"
exit 0
